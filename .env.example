# -----------------------------------------------------------------------------
# Root env — copied per-app as needed. Never commit real values.
# -----------------------------------------------------------------------------

# ---- mehedi-server (Express API) --------------------------------------------
# MongoDB Atlas connection string for the platform database
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mehedi_platform?retryWrites=true&w=majority
# Port the Express server listens on
PORT=4000
# Comma-separated list of allowed origins for CORS (web app URLs)
CORS_ORIGINS=http://localhost:3000
# Shared JWT signing secret — must match NEXTAUTH_SECRET on the web side
JWT_SECRET=change-me-to-a-long-random-string
# Node environment
NODE_ENV=development

# ---- Cloudinary (file uploads) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
# From address for platform emails
EMAIL_FROM="Mehedi Hasan <hello@mehedihasan.dev>"

# ---- mehedi-client (Next.js) ------------------------------------------------
# Public URL of the web app (used for magic links, OG images, callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the Express API from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API URL (usually same as NEXT_PUBLIC_API_URL locally)
API_URL=http://localhost:4000
# NextAuth secret — must match JWT_SECRET on the server side
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth (NextAuth Google provider) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Admin bootstrap --------------------------------------------------------
# Seeded admin account — Mehedi's login
ADMIN_EMAIL=skmehedihasan.jr1@gmail.com
ADMIN_NAME=Mehedi Hasan
# Initial admin password — change after first login
ADMIN_PASSWORD=change-me-on-first-login

# ---- Calendly (booking embed) ----------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=

# ---- WhatsApp (deep-link chat button) --------------------------------------
# Include country code without + or spaces, e.g. 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
